# 分享地址 = BASE_URL + /results/view#加密结果；BASE_URL 留空时使用当前网页域名。
BASE_URL=
HOST=127.0.0.1
PORT=5173
DATABASE_PATH=./data/bigfive.sqlite

# 钉钉 AI 表格（仅供后端使用）。APP_SECRET 的实际值只放在未跟踪的 .env 中。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# AI 表格文档 ID，以及文档内目标数据表的 ID 或名称。
DINGTALK_BASE_ID=
DINGTALK_SHEET_ID_OR_NAME=
# 用于查询操作人 unionId 的实际员工 userId。
DINGTALK_USER_ID=
# 对目标数据表有编辑权限的操作人 unionId，不是 userId。
DINGTALK_OPERATOR_ID=

# 请求保护（每个应用进程独立计数；数值必须为正整数）。
APP_MAX_CONNECTIONS=128
APP_MAX_CONCURRENT_REQUESTS=32
APP_REQUESTS_PER_SECOND=100
APP_API_REQUESTS_PER_MINUTE=180
APP_SUBMISSIONS_PER_IP_MINUTE=30
APP_SUBMISSIONS_PER_SESSION_MINUTE=5
APP_SUBMISSIONS_PER_MINUTE=60
APP_BODY_TIMEOUT_MS=10000
APP_HEADERS_TIMEOUT_MS=10000
APP_REQUEST_TIMEOUT_MS=15000
APP_MAX_PENDING_SYNC=500
APP_LIMITER_MAX_KEYS=10000
# 默认忽略转发头；仅填写实际反向代理的 IP/CIDR，禁止为方便而信任全部来源。
APP_TRUSTED_PROXIES=
